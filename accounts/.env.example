# Settings for the accounts service. Copy this file to
# /etc/rw-accounts.env on the server, fill in the values, and make it
# readable only by root (chmod 600). Do not commit the filled-in copy.

# The public URL of the site, with no final slash.
RW_BASE_URL=https://recentlywritten.com
# The web root that build.sh deploys. The service reads postdata/ in it.
RW_SITE_DIR=/var/www/recentlywritten
# The SQLite database file. The directory must be writable by the service.
RW_DB_PATH=/var/lib/rw-accounts/rw.db
# The address and port that the service listens on. Optional.
RW_LISTEN=127.0.0.1:8081
# The time between two checks for new posts. Optional. Default: 15m.
RW_NOTIFY_INTERVAL=15m

# The sender address. Its domain needs SPF and DKIM records for the
# SMTP provider.
RW_MAIL_FROM=Recently Written <posts@recentlywritten.com>
# Any SMTP server with STARTTLS: a local MTA, or the SMTP endpoint of a
# provider such as Resend (smtp.resend.com), Postmark
# (smtp.postmarkapp.com), or Amazon SES.
SMTP_HOST=
# Optional. Default: 587.
SMTP_PORT=587
# Leave empty for a server that needs no sign-in (for example a local MTA).
SMTP_USERNAME=
SMTP_PASSWORD=
