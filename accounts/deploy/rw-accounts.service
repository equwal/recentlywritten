# systemd unit for the accounts service.
# Install:
#   GOOS=linux GOARCH=amd64 go build -o accounts .   (in accounts/)
#   copy the binary to /usr/local/bin/rw-accounts
#   copy this file to /etc/systemd/system/rw-accounts.service
#   systemctl daemon-reload && systemctl enable --now rw-accounts
[Unit]
Description=Recently Written accounts, email and private feeds
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/rw-accounts.env
ExecStart=/usr/local/bin/rw-accounts
DynamicUser=yes
StateDirectory=rw-accounts
ReadOnlyPaths=/var/www/recentlywritten
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
