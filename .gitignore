# Scratch template build.sh writes and removes; ignored in case a build dies.
.build-template.html

# Third-party books the site offers as downloads. Kept out of this public
# repo because publishers file takedowns against book files on GitHub and a
# takedown disables the whole repository. build.sh still deploys them from
# the working tree, so they have to be kept on disk (and backed up) by hand.
/static/book/
/site/static/book/

# Podcast audio. It is too large for git. build.sh deploys it from the
# working tree, and its rsync rule keeps the server copy. podcast.tsv gives
# the YouTube video of each episode, so a lost file can be downloaded again.
/static/language-podcast/
/site/static/language-podcast/

# Build output and local settings of the accounts service.
/accounts/accounts
/accounts/accounts.exe
/accounts/.env
/accounts/*.db*

# stagit-gen.py's local clone cache; deploy-git.sh rebuilds it.
/.stagit-cache/
